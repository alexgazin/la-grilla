			<string>%lld дорожка</string>
			<key>few</key>
			<string>%lld дорожки</string>
			<key>many</key>
			<string>%lld дорожек</string>
			<key>other</key>
			<string>%lld дорожки</string>
		</dict>
	</dict>
	<key>%lld projects</key>
