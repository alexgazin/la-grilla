+        summary = ProjectSummary(id: id, name: name, bpm: bpm, keyRoot: keyRoot, minor: minor,
+                                 bars: end / barTicks, revision: revision, modified: modified,
+                                 schemaVersion: version, trackCount: trackCount)
+    }
+}
